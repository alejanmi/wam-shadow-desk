  {
    "check_id": "F-EARNINGS-COVERAGE",
    "layer": "L3",
    "title": "Reader companies reporting this week missing from the earnings calendar",
    "status": "finding",
    "severity": "high",
    "query": "fixtures/run6361/brief_claims.json:earnings_mentions in window 2026-10-24..2026-10-31 minus reference_disclosures.json:earnings",
    "expected": [
      "AMZN",
      "GOOG",
      "MSFT"
    ],
    "actual": {
      "calendar": [
        "AMZN"
      ],
      "missing": [
        "MSFT 2026-10-28",
        "GOOG 2026-10-28"
      ]
    },
    "detail": "The brief's own news text dates these reports inside the window, but Week Ahead lists only the calendar's names. Both cannot be right: either the FMP calendar missed them or the text is wrong. The live check (EDGAR 8-K item 2.02 after the date) settles it."
  },
