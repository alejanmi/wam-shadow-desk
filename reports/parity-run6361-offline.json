    "check_id": "F-RATINGS-NEWS-DROPPED",
    "layer": "L3",
    "title": "Rating upgrades/downgrades cut in favour of reiterations",
    "status": "finding",
    "severity": "high",
    "query": "brief_facts.rating_changes_fixed(fixtures/run6361/raw_inputs.json:grades_since_2026_10_10, now=2026-10-24T21:39:53.379000+00:00)",
    "expected": "every upgrade/downgrade in the 7-day window is shown",
    "actual": [
      "Loop Capital downgraded AAPL to Hold from Buy on 2026-10-20."
    ],
    "detail": "The Processing node ranks news above reiterations only within one company, then sorts all companies by date and keeps 6, so an older downgrade loses to newer routine reiterations."
