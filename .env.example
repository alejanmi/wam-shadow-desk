# Copy to .env (never commit .env). Use NEWLY ROTATED keys, not the ones that were embedded in the n8n workflow.
FMP_API_KEY=
FRED_API_KEY=
# SEC asks every client to identify itself: "Name contact@email"
SEC_USER_AGENT=
# Optional: where snapshots and the ledger live (default ./data)
SHADOWDESK_DATA=./data
